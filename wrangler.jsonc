{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icon-po6",
  "main": "src/index.ts",
  // 拥有 po6.sh 这个 zone 的 Cloudflare 账号(Edwin.jh.lee@gmail.com's Account)
  "account_id": "d8caf3f6df38f81423fd3ed39534f753",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 静态资源:图标文件与清单。目录结构是 public/icon/**,
  // 路由是 po6.sh/icon*,所以 /icon/i/… 与 /icon/manifest.json 由边缘直接发。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 挂在 po6.sh/icon 下;改域名只改这一行
  "routes": [
    { "pattern": "po6.sh/icon*", "zone_name": "po6.sh" }
  ],
  "workers_dev": true,
  "preview_urls": false
}
